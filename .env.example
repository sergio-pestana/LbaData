# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ver .gitignore) — Princípio V da constituição.

# Conexão Postgres do projeto Supabase, em variáveis separadas (não uma única
# URI) — evita bugs de parsing quando a senha contém caracteres especiais
# como "@" (ver research.md #1).
#
# Use o SESSION POOLER (Supabase → Connect → Session pooler), não a conexão
# direta: no plano free, a conexão direta (db.<ref>.supabase.co) só tem
# endereço IPv6, e redes sem rota IPv6 (a maioria) recebem "Connection
# refused" — ver research.md #11. O pooler tem endereço IPv4 e é gratuito em
# qualquer plano; só muda o formato do usuário (postgres.<project-ref>, não
# só "postgres").
SUPABASE_DB_HOST=aws-0-xx-xxxx-x.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=troque-por-sua-senha-real

# IDs fixos da temporada Ouro 2026 da LBA POA (ver contracts/go-champs-api-dependency.md)
LBA_TOURNAMENT_ID=5bf23f0b-6768-46ec-bcc1-4cd698105413
LBA_PHASE_ID=ede46bb2-21ac-411b-b07f-b93269bebd37

# Intervalo mínimo (segundos) entre requisições ao go-champs — Princípio II
COLLECTOR_REQUEST_INTERVAL_SECONDS=1.5
